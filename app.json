{
  "expo": {
    "name": "Ассистент психолога",
    "slug": "assistant-psychologist",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#171717"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ru.psychologist.assistant",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Запись сессии с клиентом.",
        "NSSpeechRecognitionUsageDescription": "Расшифровка речи для анамнеза.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#171717"
      },
      "package": "ru.psychologist.assistant",
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "WAKE_LOCK",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      ["expo-av", { "microphonePermission": "Микрофон для записи приёма." }],
      "@react-native-voice/voice",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#8b5cf6"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "psychologist-assistant-local"
      }
    }
  }
}
